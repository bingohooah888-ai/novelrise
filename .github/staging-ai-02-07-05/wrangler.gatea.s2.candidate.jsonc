{
  "name": "novelight-ai-gatea-watchdog",
  "main": "./cloudflare-gatea-live-candidate.mjs",
  "account_id": "6831b18fe814232fa2dd4c470b95aa15",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEA_WATCHDOG",
        "class_name": "GateAWatchdogDurableObject"
      }
    ]
  },
  "vars": {
    "GATEA_LIVE_ENABLED": "false",
    "GATEA_HTTP_ADMISSION_ENABLED": "false"
  },
  "exports": {
    "GateAWatchdogDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
