    },
    {
      "id": "nlo.github.owner-draft-pr-sync",
      "description": "Automatically synchronize eligible non-high-risk owner Draft PRs using NLO's existing scoped GitHub owner credential and native PR CI; requires Pull requests and Contents write; no new PAT or Actions Secret.",
      "intents": [
        "synchronize draft pull request branch",
        "keep owner draft PR up to date",
        "NOVELIGHTのDraft PRをmainへ自動同期"
      ],
      "aliases": [
        "automatic update branch",
        "NLO GitHub branch sync"
      ],
      "adapter": "tools/novelight-commander/src/owner-draft-auto-sync.js",
      "executionRisk": "B",
      "requiredPermissions": [
        "existing_nlo_dpapi_protected_owner_github_auth",
        "repo_metadata_read",
        "pull_request_read",
        "issue_comments_read",
        "pull_requests_write",
        "repo_contents_write"
      ],
      "testCommands": [
        "node --test tests/novelight-pr-auto-sync.test.mjs"
      ],
      "version": "0.4.0",
      "status": "enabled",
      "provenance": "2026-10-14 #2219 live native PR synchronize CI/CodeQL proof; high-risk path and late-approval guards; activation requires protected main merge and local NLO update"
    },
    {
