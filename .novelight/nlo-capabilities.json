        "resolve capability",
        "capability gap",
        "missing capability"
      ],
      "aliases": [
        "missing nlo capability",
        "unsupported nlo capability"
      ],
      "adapter": "scripts/nlo-capability-core.mjs",
      "executionRisk": "A",
      "requiredPermissions": [
        "repo_read",
        "local_git_state_write"
      ],
      "testCommands": [
        "node --test tests/nlo-capability-core.test.mjs"
      ],
      "version": "1.0.0",
      "status": "enabled",
      "provenance": "NOVELIGHT self-expansion core"
    },
    {
