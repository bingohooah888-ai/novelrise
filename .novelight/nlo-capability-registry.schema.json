{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelight.jp/schemas/nlo-capability-registry.schema.json",
  "title": "NOVELIGHT NLO Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "intents",
          "adapter",
          "executionRisk",
          "requiredPermissions",
          "testCommands",
          "version",
          "status",
          "provenance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "intents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "adapter": { "type": "string", "minLength": 1 },
          "executionRisk": { "enum": ["A", "B", "C"] },
          "requiredPermissions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "testCommands": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "version": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["enabled", "testing", "proposed", "quarantined", "disabled"]
          },
          "provenance": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
