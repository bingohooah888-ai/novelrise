{
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "eslint \"api/**/*.js\" \"tests/**/*.js\" \"tests/**/*.mjs\"",
    "format": "prettier --write \"api/**/*.js\" \"tests/**/*.{js,mjs,json}\" \"*.json\" \".github/workflows/*.yml\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"api/**/*.js\" \"tests/**/*.{js,mjs,json}\" \"*.json\" \".github/workflows/*.yml\" \"eslint.config.mjs\"",
    "syntax:check": "node scripts/check-js-syntax.mjs",
    "preflight": "npm run format:check && npm run lint && npm test && npm run syntax:check && git diff --check",
    "preflight:db": "bash scripts/run-rls-integration.sh",
    "preflight:e2e": "npm --prefix tests/e2e test",
    "preflight:full": "npm run preflight && npm run preflight:db && npm run preflight:e2e"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "prettier": "^3.0.0"
  }
}
